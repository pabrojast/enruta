# Base de datos (Docker Compose local)
DATABASE_URL=postgresql://enruta:enruta_secret@localhost:5433/enruta

# Auth.js — genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia-este-secreto-en-produccion-min-32
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Opcional: gateway LLM OpenAI-compatible para el borrador del informe.
# Sin estos valores se usa la plantilla determinística.
# AI_BASE_URL=https://ai.creaciv.com/v1
# AI_API_KEY=
# AI_MODEL=creaciv/deepseek-v4-pro

# Correo (opcional). Sin estos valores, los mails se guardan en email_outbox.
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ENRUTA <noreply@enruta.cl>

# Demo
DEMO_PASSWORD=EnrutaDemo2026!

